    modal.innerHTML = `

        <div class="modal">

            <div class="modal-header">

                <h2>
                    Condiciones · ${d.nombre}
                </h2>


                <button
                    class="close"
                    id="close"
                >

                    Cerrar

                </button>

            </div>


            <div>

                ${
                    d.condiciones
                        .map(
                            condition => `

                                <div class="condition">

                                    ✓ ${condition}

                                </div>

                            `
                        )
                        .join("")
                }

            </div>


            <p class="muted">

                Estas condiciones proceden
                del tarifario facilitado.

                Comprueba siempre la documentación
                vigente antes de realizar una contratación.

            </p>

        </div>

    `;


    document.body.appendChild(modal);


    modal
        .querySelector("#close")
        .addEventListener(
            "click",
            () => modal.remove()
        );


    modal.addEventListener(
        "click",
        event => {

            if(event.target === modal) {

                modal.remove();

            }

        }
    );

}


