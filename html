/* =========================================================
   EVENTOS DEL CONSTRUCTOR
========================================================= */

function bindBuilder() {

    const addLine =
        document.getElementById("addLine");


    if(addLine) {

        addLine.addEventListener(
            "click",
            () => {

                const select =
                    document.getElementById("lineSelect");


                if(
                    !select ||
                    select.value === ""
                ) {

                    return;

                }


                const d =
                    companyData();


                const selected =
                    d.lineas[
                        Number(select.value)
                    ];


                state.lines.push({

                    id:
                        "line-" +
                        Date.now() +
                        Math.random(),

                    nombre:
                        selected[0],

                    precio:
                        Number(selected[1])

                });


                renderContent();

            }
        );

    }


    document
        .querySelectorAll("[data-remove-line]")
        .forEach(button => {

            button.addEventListener(
                "click",
                () => {

                    state.lines.splice(
                        Number(
                            button.dataset.removeLine
                        ),
                        1
                    );

                    renderContent();

                }
            );

        });


    document
        .querySelectorAll("[data-extra]")
        .forEach(button => {

            button.addEventListener(
                "click",
                () => {

                    const d =
                        companyData();


                    const extra =
                        d.extras[
                            Number(button.dataset.extra)
                        ];


                    const existing =
                        state.extras.findIndex(
                            item =>
                                item.id ===
                                extra.id
                        );


                    if(existing >= 0) {

                        state.extras.splice(
                            existing,
                            1
                        );

                    }

                    else {

                        state.extras.push({

                            id:
                                extra.id,

                            nombre:
                                extra.nombre,

                            precio:
                                Number(extra.precio)

                        });

                    }


                    renderContent();

                }
            );

        });

}


