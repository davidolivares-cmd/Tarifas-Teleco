<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Configurador Comercial</title>

<style>

/* =========================================================
   CONFIGURACIÓN GENERAL
========================================================= */

:root {
    --negro: #171717;
    --gris: #68707d;
    --gris-claro: #f5f6f8;
    --borde: #e2e5e9;

    --masmovil: #f2c400;
    --yoigo: #b41472;
    --vodafone: #e60000;
    --lowi: #d51f26;

    --blanco: #ffffff;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #f4f5f7;
    color: var(--negro);
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;
}

button,
select,
input {
    font: inherit;
}

button {
    cursor: pointer;
}

/* =========================================================
   HEADER
========================================================= */

.header {
    background: white;
    border-bottom: 1px solid var(--borde);
    position: sticky;
    top: 0;
    z-index: 50;
}

.header-inner {
    max-width: 1200px;
    margin: auto;
    min-height: 65px;

    padding: 0 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 18px;
    font-weight: 900;
}

.logo span {
    background: var(--negro);
    color: white;

    padding: 5px 8px;
    border-radius: 7px;

    margin-right: 7px;
}

.container {
    width: min(1200px, calc(100% - 30px));
    margin: auto;
}

/* =========================================================
   BOTONES
========================================================= */

.btn {
    border: 1px solid var(--borde);
    background: white;

    padding: 10px 14px;

    border-radius: 10px;

    font-size: 13px;
    font-weight: 800;
}

.btn:hover {
    border-color: #b7bcc3;
}

.btn-full {
    width: 100%;
}

.btn-masmovil {
    background: var(--masmovil);
    border-color: var(--masmovil);
    color: #111;
}

.btn-yoigo {
    background: var(--yoigo);
    border-color: var(--yoigo);
    color: white;
}

.btn-vodafone {
    background: var(--vodafone);
    border-color: var(--vodafone);
    color: white;
}

.btn-lowi {
    background: var(--lowi);
    border-color: var(--lowi);
    color: white;
}

/* =========================================================
   HOME
========================================================= */

main {
    padding: 35px 0 60px;
}

.hero {
    text-align: center;
    max-width: 750px;

    margin: 0 auto 35px;
}

.eyebrow {
    color: var(--gris);

    font-size: 11px;
    font-weight: 900;

    text-transform: uppercase;
    letter-spacing: .12em;
}

.hero h1 {
    font-size: 40px;
    line-height: 1.05;

    margin: 8px 0 12px;

    letter-spacing: -1px;
}

.hero p {
    color: var(--gris);

    font-size: 15px;
    line-height: 1.55;

    margin: 0;
}

/* =========================================================
   COMPAÑÍAS
========================================================= */

.company-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 16px;
}

.company-card {
    background: white;

    border: 1px solid var(--borde);

    border-radius: 20px;

    padding: 24px;

    min-height: 245px;

    text-align: left;

    position: relative;

    overflow: hidden;

    transition: .15s;
}

.company-card:hover {
    transform: translateY(-3px);

    box-shadow:
        0 10px 30px rgba(0,0,0,.07);
}

.company-card::before {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    top: 0;

    height: 5px;

    background: var(--company-color);
}

.company-card.masmovil {
    --company-color: var(--masmovil);
}

.company-card.yoigo {
    --company-color: var(--yoigo);
}

.company-card.vodafone {
    --company-color: var(--vodafone);
}

.company-card.lowi {
    --company-color: var(--lowi);
}

.company-logo {
    font-size: 26px;
    font-weight: 950;

    margin-bottom: 25px;
}

.company-card.masmovil .company-logo span {
    background: var(--masmovil);

    padding: 2px 6px;

    border-radius: 5px;
}

.company-card.yoigo .company-logo {
    color: var(--yoigo);
}

.company-card.vodafone .company-logo {
    color: var(--vodafone);
}

.company-card.lowi .company-logo {
    color: var(--lowi);
}

.company-card h2 {
    font-size: 19px;

    margin: 0 0 7px;
}

.company-card p {
    color: var(--gris);

    font-size: 12px;
    line-height: 1.5;

    margin: 0;
}

.company-go {
    font-size: 12px;

    font-weight: 900;

    margin-top: 20px;
}

.company-card.yoigo .company-go {
    color: var(--yoigo);
}

.company-card.vodafone .company-go {
    color: var(--vodafone);
}

.company-card.lowi .company-go {
    color: var(--lowi);
}

/* =========================================================
   WORKSPACE
========================================================= */

.workspace-head {
    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 15px;
}

.company-title {
    font-size: 27px;

    font-weight: 950;

    margin-right: auto;
}

.company-title.masmovil {
    color: #111;
}

.company-title.yoigo {
    color: var(--yoigo);
}

.company-title.vodafone {
    color: var(--vodafone);
}

.company-title.lowi {
    color: var(--lowi);
}

.search {
    width: 100%;

    background: white;

    border: 1px solid var(--borde);

    border-radius: 12px;

    padding: 13px 14px;

    margin-bottom: 14px;
}

.tabs {
    display: flex;

    gap: 7px;

    overflow-x: auto;

    padding-bottom: 5px;

    margin-bottom: 18px;
}

.tab {
    white-space: nowrap;

    background: white;

    border: 1px solid var(--borde);

    border-radius: 999px;

    padding: 9px 15px;

    font-size: 12px;

    font-weight: 850;
}

.tab.active {
    background: var(--negro);

    color: white;

    border-color: var(--negro);
}

.tab.active.yoigo {
    background: var(--yoigo);
    border-color: var(--yoigo);
}

.tab.active.vodafone {
    background: var(--vodafone);
    border-color: var(--vodafone);
}

.tab.active.lowi {
    background: var(--lowi);
    border-color: var(--lowi);
}

/* =========================================================
   LAYOUT
========================================================= */

.layout {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        360px;

    gap: 18px;

    align-items: start;
}

.card {
    background: white;

    border: 1px solid var(--borde);

    border-radius: 16px;

    padding: 18px;

    margin-bottom: 14px;
}

.card h3 {
    font-size: 15px;

    margin: 0 0 14px;
}

.label {
    color: var(--gris);

    font-size: 10px;

    font-weight: 900;

    text-transform: uppercase;

    letter-spacing: .06em;

    margin: 14px 0 7px;
}

.select {
    width: 100%;

    background: white;

    border: 1px solid var(--borde);

    border-radius: 10px;

    padding: 11px 12px;
}

/* =========================================================
   OPCIONES
========================================================= */

.options {
    display: grid;

    gap: 8px;
}

.option {
    width: 100%;

    text-align: left;

    background: white;

    border: 1px solid var(--borde);

    border-radius: 12px;

    padding: 13px;

    transition: .12s;
}

.option:hover {
    border-color: #aeb4bc;
}

.option.selected {
    border: 2px solid var(--negro);

    padding: 12px;
}

.option.selected.yoigo {
    border-color: var(--yoigo);
}

.option.selected.vodafone {
    border-color: var(--vodafone);
}

.option.selected.lowi {
    border-color: var(--lowi);
}

.option-title {
    font-size: 13px;

    font-weight: 900;
}

.option-price {
    float: right;

    font-size: 13px;

    font-weight: 950;
}

.option-detail {
    color: var(--gris);

    font-size: 11px;

    line-height: 1.45;

    margin-top: 5px;
}

.badge {
    display: inline-block;

    background: #f0f1f3;

    border-radius: 999px;

    padding: 4px 7px;

    font-size: 9px;

    font-weight: 900;

    margin-top: 7px;
}

/* =========================================================
   LÍNEAS
========================================================= */

.included-line {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 10px;

    border: 1px solid var(--borde);

    border-radius: 11px;

    padding: 11px;

    margin-top: 7px;
}

.included-line strong {
    font-size: 12px;
}

.included-line small {
    display: block;

    color: var(--gris);

    font-size: 10px;

    margin-top: 2px;
}

.pill {
    background: #f0f1f3;

    border-radius: 999px;

    padding: 5px 8px;

    font-size: 9px;

    font-weight: 900;

    white-space: nowrap;
}

.add-line {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        auto;

    gap: 8px;

    margin-top: 8px;
}

.selected-item {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 10px;

    border: 1px solid var(--borde);

    border-radius: 10px;

    padding: 10px;

    margin-top: 7px;
}

.selected-item strong {
    font-size: 11px;
}

.selected-item span {
    font-size: 11px;

    font-weight: 900;
}

.remove {
    border: 0;

    background: #f0f1f3;

    border-radius: 7px;

    padding: 7px 9px;

    font-size: 10px;

    font-weight: 850;

    margin-left: 5px;
}

/* =========================================================
   RESUMEN
========================================================= */

.summary {
    background: white;

    border: 1px solid var(--borde);

    border-radius: 18px;

    overflow: hidden;

    position: sticky;

    top: 85px;
}

.summary.masmovil {
    border-top: 6px solid var(--masmovil);
}

.summary.yoigo {
    border-top: 6px solid var(--yoigo);
}

.summary.vodafone {
    border-top: 6px solid var(--vodafone);
}

.summary.lowi {
    border-top: 6px solid var(--lowi);
}

.summary-body {
    padding: 18px;
}

.summary h3 {
    font-size: 13px;

    margin: 0 0 14px;
}

.price-block {
    border-top: 1px solid var(--borde);

    border-bottom: 1px solid var(--borde);

    padding: 15px 0;
}

.price-label {
    color: var(--gris);

    font-size: 11px;
}

.big-price {
    font-size: 36px;

    font-weight: 950;

    line-height: 1.1;

    margin: 4px 0;
}

.big-price small {
    font-size: 12px;
}

.after-price {
    font-size: 14px;

    font-weight: 850;

    margin-top: 5px;
}

.breakdown {
    background: #fafafa;

    border-radius: 11px;

    padding: 11px;

    margin: 12px 0;
}

.break-row {
    display: flex;

    justify-content: space-between;

    gap: 10px;

    font-size: 11px;

    padding: 4px 0;
}

.break-row.total {
    border-top: 1px solid var(--borde);

    padding-top: 8px;

    margin-top: 5px;

    font-weight: 950;
}

.summary-list {
    list-style: none;

    padding: 0;

    margin: 13px 0;
}

.summary-list li {
    border-bottom: 1px solid #f0f0f0;

    padding: 8px 0;

    font-size: 11px;

    line-height: 1.45;
}

.summary-list li:last-child {
    border: 0;
}

.info {
    background: #f5f6f8;

    border-radius: 10px;

    padding: 10px;

    font-size: 10.5px;

    line-height: 1.5;

    margin: 12px 0;
}

.actions {
    display: grid;

    gap: 8px;
}

/* =========================================================
   BÚSQUEDA
========================================================= */

.results {
    display: grid;

    gap: 8px;
}

.result {
    background: white;

    border: 1px solid var(--borde);

    border-radius: 12px;

    padding: 13px;
}

.result strong {
    font-size: 12px;
}

.result-price {
    float: right;

    font-weight: 950;
}

.result p {
    color: var(--gris);

    font-size: 10.5px;

    line-height: 1.45;

    margin: 5px 0 0;
}

.empty {
    border: 1px dashed #c7ccd2;

    border-radius: 12px;

    padding: 28px;

    text-align: center;

    color: var(--gris);

    font-size: 12px;
}

/* =========================================================
   CLIENTE
========================================================= */

.client-wrap {
    max-width: 570px;

    margin: 20px auto;
}

.client-card {
    background: white;

    border: 1px solid var(--borde);

    border-radius: 22px;

    padding: 26px;
}

.client-company {
    color: var(--gris);

    font-size: 11px;

    font-weight: 900;

    text-transform: uppercase;
}

.client-card h1 {
    font-size: 28px;

    margin: 7px 0 18px;
}

.client-price {
    font-size: 44px;

    font-weight: 950;
}

.client-price small {
    font-size: 13px;
}

.client-after {
    color: var(--gris);

    font-size: 12px;

    margin: 5px 0 18px;
}

.client-item {
    border-bottom: 1px solid var(--borde);

    padding: 11px 0;

    font-size: 12px;
}

.client-note {
    background: #f5f6f8;

    border-radius: 11px;

    padding: 11px;

    font-size: 10px;

    line-height: 1.5;

    margin-top: 15px;
}

/* =========================================================
   MODAL
========================================================= */

.modal-bg {
    position: fixed;

    inset: 0;

    background: rgba(0,0,0,.45);

    z-index: 100;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 20px;
}

.modal {
    width: min(600px,100%);

    max-height: 90vh;

    overflow: auto;

    background: white;

    border-radius: 18px;

    padding: 20px;
}

.modal-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 10px;
}

.modal h2 {
    margin: 0;

    font-size: 19px;
}

.close {
    border: 0;

    background: #f0f1f3;

    border-radius: 8px;

    padding: 8px 11px;

    font-weight: 900;
}

.condition {
    border: 1px solid var(--borde);

    border-radius: 10px;

    padding: 11px;

    font-size: 11px;

    line-height: 1.5;

    margin-top: 8px;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1000px) {

    .company-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .layout {
        grid-template-columns: 1fr;
    }

    .summary {
        position: static;
    }
}

@media(max-width:600px) {

    .container {
        width: calc(100% - 18px);
    }

    main {
        padding-top: 20px;
    }

    .hero h1 {
        font-size: 30px;
    }

    .company-grid {
        grid-template-columns: 1fr;
    }

    .company-card {
        min-height: auto;
    }

    .workspace-head {
        align-items: flex-start;
    }

    .company-title {
        font-size: 23px;
    }

    .add-line {
        grid-template-columns: 1fr;
    }

    .big-price {
        font-size: 32px;
    }
}

</style>
</head>


