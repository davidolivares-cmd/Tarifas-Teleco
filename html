/* =========================================================
   UTILIDADES
========================================================= */

function euro(value) {

    return Number(value).toLocaleString(
        "es-ES",
        {
            minimumFractionDigits:2,
            maximumFractionDigits:2
        }
    ) + " €";

}


function companyData() {

    return DATA[state.company];

}


function resetBuilder() {

    state.base = null;

    state.lines = [];

    state.extras = [];

    state.digi = false;

}


function totalInitial() {

    let total = 0;

    if(state.base) {

        total += Number(state.base.precio) || 0;

    }

    state.lines.forEach(line => {

        total += Number(line.precio) || 0;

    });

    state.extras.forEach(extra => {

        total += Number(extra.precio) || 0;

    });

    return total;

}


function totalAfter() {

    if(!state.base) {
        return null;
    }

    if(
        state.base.despues === null ||
        state.base.despues === undefined
    ) {
        return null;
    }

    let total = Number(state.base.despues) || 0;

    state.lines.forEach(line => {

        total += Number(line.precio) || 0;

    });

    state.extras.forEach(extra => {

        total += Number(extra.precio) || 0;

    });

    return total;

}


