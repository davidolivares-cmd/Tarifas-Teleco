/* =========================================================
   BUSCADOR
========================================================= */

function renderSearch(content) {

    const d =
        companyData();


    const query =
        state.search
            .trim()
            .toLowerCase();


    let products = [];


    products.push(
        ...baseCatalog()
    );


    d.lineas.forEach(
        line => {

            products.push({

                id:
                    "search-line-" +
                    line[0],

                nombre:
                    "Línea adicional · " +
                    line[0],

                precio:
                    line[1],

                despues:null,

                detalle:
                    "Línea adicional",

                categoria:
                    "Extra"

            });

        }
    );


    d.extras.forEach(
        extra => {

            products.push({

                id:
                    extra.id,

                nombre:
                    extra.nombre,

                precio:
                    extra.precio,

                despues:
                    extra.despues,

                detalle:
                    extra.detalle,

                categoria:
                    "Extra"

            });

        }
    );


    const results =
        products.filter(
            product => {

                const text =
                    (
                        product.nombre +
                        " " +
                        (product.detalle || "") +
                        " " +
                        (product.categoria || "")
                    )
                    .toLowerCase();


                return text.includes(query);

            }
        );


    content.innerHTML = `

        <div class="card">

            <h3>
                Buscar en ${d.nombre}
            </h3>


            <div class="results">

                ${
                    results.length

                    ?

                    results.map(
                        product => `

                            <div class="result">

                                <span class="result-price">

                                    ${euro(product.precio)}/mes

                                </span>


                                <strong>

                                    ${product.nombre}

                                </strong>


                                <p>

                                    ${product.detalle || ""}

                                    ${
                                        product.despues !== null &&
                                        product.despues !== undefined

                                        ?

                                        ` · Después:
                                           ${euro(product.despues)}/mes`

                                        :

                                        ""

                                    }

                                </p>

                            </div>

                        `
                    ).join("")

                    :

                    `

                    <div class="empty">

                        No se han encontrado resultados.

                    </div>

                    `

                }

            </div>

        </div>

    `;

}


